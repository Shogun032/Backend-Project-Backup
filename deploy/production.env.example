# Template only. Supply real values through the deployment platform / --env-file.
# This template intentionally fails validation until all secrets are replaced.
NODE_ENV=production
PORT=3000
TZ=Asia/Bangkok

# Generate a fresh random secret (at least 32 bytes); same secret on all API instances.
JWT_SECRET=
JWT_EXPIRES_IN=900

# Service names are examples. URL-encode credentials containing special characters.
DATABASE_URL=mysql://hotel_app:CHANGE_ME@mysql:3306/hotel_booking
REDIS_URL=redis://:CHANGE_ME@redis:6379/0

RATE_LIMIT_STORAGE=redis
# Must be identical on all instances; use another prefix for staging/testing.
RATE_LIMIT_PREFIX=hotel-booking:production:rate-limit
# Keep false until actual proxy addresses are known. Never use true or a hop count.
# Railway (measured 2026-11, subject to change): socket hops in 100.64.0.0/10 and the
# CDN hop in front of the edge is in 152.233.0.0/16, e.g.
# TRUST_PROXY=100.64.0.0/10,152.233.0.0/16
TRUST_PROXY=false
# Temporary diagnostics: set true once to log remoteAddress/req.ip/X-Real-IP/
# X-Forwarded-For per request, read the values from the logs, set TRUST_PROXY
# to cover every hop, then switch back to false.
DEBUG_FORWARDED=false

# Required only when running docker-compose.prod.yml locally/on your own server.
# Match MYSQL_PASSWORD/REDIS_PASSWORD with the URL-encoded passwords above.
MYSQL_ROOT_PASSWORD=CHANGE_ME
MYSQL_DATABASE=hotel_booking
MYSQL_USER=hotel_app
MYSQL_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
API_PORT=3000
